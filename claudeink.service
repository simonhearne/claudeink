[Unit]
Description=Claude usage tracker on Inky pHAT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/claudeink
ExecStart=/home/pi/claudeink/.venv/bin/python /home/pi/claudeink/run.py
Environment=REFRESH_MINUTES=2
Environment=PLAN_LABEL="Max 5x"
Environment=WARN_AT=80
Environment=QUIET_START=20
Environment=QUIET_END=7
## Uncomment to flip the rendered image 180 degrees
#Environment=FLIP=1
## Uncomment for flash-free partial updates (Waveshare V4/V3 only),
## with a flashing ghost-clearing full refresh once an hour
#Environment=PARTIAL_REFRESH=1
#Environment=FULL_REFRESH_MINUTES=60
## Uncomment to serve the status web ui
#Environment=WEB_UI=1
#Environment=WEB_PORT=8080
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
